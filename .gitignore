# Build output
node_modules/
dist/
dist-dev/
# The storefront hand-off (npm run build:storefront): its own directory, so dist/ stays byte-identical (S20)
dist-storefront/

# The mock-ups' output: its PNGs and its copies of the photos carry photographs.
dist-mockups/

# Storybook (boston-2026-10/tools/storybook, SPEC-storybook-microsite.md): its static build, and the log it writes on a
# failure. The pages it shows are the site's build, written under its node_modules/.cache/ (ignored above)
storybook-static/
debug-storybook.log

# ⛔ Photographs. This repository is PUBLIC and a photo's usage rights are the Owner's: the mock-ups read
# them from this folder, named by the committed mockups/photos.json, and none is ever committed.
/boston-2026-10/mockups/photos/
# The live store's pictures, taken by the watch's probes and its smoke (storefront/probe-*/, storefront/smoke-*/): they
# carry the store's own food photographs, so they stay beside their run files and are never committed (P1).
/boston-2026-10/storefront/**/*.png
/boston-2026-10/storefront/**/*.jpg

# The flow diagrams' PNGs (2x, for screen sharing) are rebuilt by `npm run render:flows`; the SVGs are committed
boston-2026-10/flows/rendered/*.png

# Wrangler / Miniflare local state (its cache holds request location data)
.wrangler/

# ⛔ Local secrets. This repository is PUBLIC. Wrangler reads a Worker's local secrets from .dev.vars
# (or .env); neither may ever be committed. Worker secrets are set by the operator's scripts, never in a file here.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Test output
coverage/
test-results/
playwright-report/

# Vite's config timestamp files
vite.config.*.timestamp-*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
