{
  "name": "fitaf-microsite-boston-2026-10",
  "version": "0.1.0",
  "private": true,
  "description": "Front door for the Boston 2026-10 trip: a static plan picker linking to the Fit AF store.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --env dev",
    "test": "node --test \"test/*.test.mjs\"",
    "contrast": "node scripts/contrast.mjs",
    "email:tokens": "node scripts/email-tokens.mjs",
    "preview:emails": "node scripts/preview-emails.mjs",
    "db:migrate:dev": "wrangler d1 migrations apply fitaf-leads-dev --env dev --remote",
    "seed:dev": "node scripts/seed-dummy.mjs --remote",
    "purge:dev": "node scripts/purge.mjs --remote",
    "erase:dev": "node scripts/erase.mjs --remote",
    "preview": "wrangler dev",
    "preview:dev": "npm run build:dev && wrangler dev --env dev",
    "cf:whoami": "wrangler whoami",
    "cf:versions": "wrangler versions list",
    "cf:versions:dev": "wrangler versions list --env dev"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "apca-w3": "^0.1.9",
    "esbuild": "0.28.1",
    "jsqr": "^1.4.0",
    "miniflare": "5.20260926.0-alpha",
    "pngjs": "^7.0.0",
    "wrangler": "^4.142.0"
  }
}
