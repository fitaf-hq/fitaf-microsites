{
  // Wrangler config for this microsite: a static-assets Worker serving dist/, with a script for the week (below).
  // ⛔ Since 2026-09-29 nothing here is DEPLOYED by wrangler: both Workers and their secrets are managed as
  // infrastructure as code, applied by CI, which MIRRORS these settings (README, "Deploys are not run from
  // here"). This file drives local preview and `db:migrate:dev` only; a change here reaches nothing live
  // until it is mirrored there. The account is chosen by CLOUDFLARE_ACCOUNT_ID, never stored here (public repo).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitaf-microsites",
  "compatibility_date": "2026-09-26",

  // SPEC-week-content § 4 (2026-10-11): production gains a script, src/worker/site.js, doing ONLY two things: the week
  // from the WEEK bucket put into the page's #picks-data, and the photo sheets at /week/<file>.jpg. Nothing else (no D1,
  // no rate limiter, no cron, no other route). The names below (WEEK, the bucket, the objects) are the interface with
  // the infrastructure code, which mirrors this file; they change only with both.
  "main": "src/worker/site.js",
  // The page's routes run the script BEFORE the assets (`run_worker_first`, the platform's setting; patterns are matched
  // against the path, "*" any characters): "/" is the only path the assets answer with the page (measured: "/index.html"
  // and "/index" are their 307 to "/", passed on unchanged). Every other route stays assets-first: an asset is served
  // without the script; a path no asset matches (/week/…, or anything else) reaches the script, which hands all but
  // /week/ back to the assets.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  // The week's content (SPEC-week-content § 1): read only through this binding; the bucket is not public.
  "r2_buckets": [{ "binding": "WEEK", "bucket_name": "fitaf-microsite-content-prod" }],
  // SPEC-analytics.md § 6 (the Advisor's word, 2026-10-13; the infrastructure's Amendment 1.8 mirrors these names): the
  // page's analytics, POST /a (src/worker/beacon.js). ANALYTICS: a Workers Analytics Engine dataset, one per environment.
  // SALTS: a KV namespace holding only the daily salt, every key expiring within 48 h; the namespace is
  // fitaf-microsite-salts-prod, created by the infrastructure code, and wrangler's KV entry has no field for its name
  // and needs no id for local preview (its id is the infrastructure's, never kept here).
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "fitaf_microsite_analytics_prod" }],
  "kv_namespaces": [{ "binding": "SALTS" }],

  // ⛔ No per-version preview URLs (<version>-<name>.<subdomain>.workers.dev). On 2026-09-27 a version
  // uploaded by mistake stayed PUBLIC at its preview URL after later deploys replaced it on the main
  // address; only deleting the Worker removed it. A replaced version must not stay reachable.
  "preview_urls": false,

  // ⛔ Explicit: with custom domains present, wrangler DISABLES the workers.dev address unless told otherwise
  // (observed 2026-09-27 on the first domain deploy). It stays on, so QR codes printed before the domain work.
  "workers_dev": true,

  // The vanity domain (bought 2026-09-27, a zone in the same Fit AF account). Custom domains, so Cloudflare
  // manages the DNS record and the certificate. The workers.dev address keeps working.
  "routes": [
    { "pattern": "eatfitaf.com", "custom_domain": true },
    { "pattern": "www.eatfitaf.com", "custom_domain": true }
  ],

  // ⛔ The top level above is PRODUCTION. Rungs 3 and 4 left it unchanged (no script, no bindings); since
  // SPEC-week-content § 4 it has one script and two bindings (ASSETS, WEEK), for the week and nothing else; since
  // SPEC-analytics.md § 6 two more (ANALYTICS, SALTS), for the page's analytics and nothing else.
  "env": {
    // Rungs 3–4 (SPEC-rung4-save-offer.md): development only, dummy data only.
    "dev": {
      "name": "fitaf-microsites-dev",
      // workers.dev on explicitly (see the top level); dev has NO routes: routes do not inherit, so dev never
      // claims eatfitaf.com.
      "workers_dev": true,
      // No per-version preview URLs here either (see the top level).
      "preview_urls": false,
      "main": "src/worker/index.js",
      // Assets first; a request no asset matches (/api/save, /confirm/*, /o/*, /week/*) reaches the Worker script.
      // SPEC-week-content § 4.5: the page's routes run the script first, so it can put the week in: "/" and each event's
      // "/<event-id>/" (the assets' "/index.html" and "/<event-id>/index.html" are their 307s, passed on). "/*/" is any
      // path ending "/", which only an event page answers with an asset; every other asset stays assets-first.
      "assets": { "directory": "./dist-dev", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/*/", "/*/index.html"] },
      // The week's content (SPEC-week-content § 1); bindings do not inherit, so dev names its own bucket.
      "r2_buckets": [{ "binding": "WEEK", "bucket_name": "fitaf-microsite-content-dev" }],
      // SPEC-analytics.md § 6, as at the top level: the dev dataset, and the namespace fitaf-microsite-salts-dev.
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "fitaf_microsite_analytics_dev" }],
      "kv_namespaces": [{ "binding": "SALTS" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fitaf-leads-dev",
          "database_id": "c149bbda-089a-4a13-af9f-45b1e8e854f8",
          "migrations_dir": "migrations"
        }
      ],
      // The binding's period can only be 10 or 60 seconds (rung 3 asked for "per hour"; see README).
      // Saves, and lookups (/confirm, /o), are limited separately, each 5 per 60 s per IP.
      "ratelimits": [
        { "name": "SAVE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "LOOKUP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
      ],
      // The scheduled Worker (SPEC-rung4 § 6): send what is due (Resend behind the allowlist when the key is
      // set, rung 5; otherwise the NULL sender), lapse, purge.
      "triggers": { "crons": ["*/5 * * * *"] },
      // Cloudflare's PUBLISHED Turnstile test keys (always pass, invisible widget). Not secrets.
      // Production will set TURNSTILE_SECRET_KEY as a secret in the infrastructure code, never here.
      // SITE_URL: the dev Worker's public address, for the links inside E1 and E-X.
      // MAIL_FROM (rung 5): the sender address, public; ⬜ a PLACEHOLDER until the Owner names one.
      // ⛔ RESEND_API_KEY, SEND_ALLOWLIST and CONFIRM_TOKEN_KEY are Worker SECRETS, never here: the
      // infrastructure code sets them (the `secret:*` scripts that did are retired, 2026-09-29).
      // Without the Resend key nothing is sent.
      "vars": {
        "SITE_URL": "https://fitaf-microsites-dev.fitaf-microsite-boston-2026-10.workers.dev",
        "MAIL_FROM": "Fit AF <offers@eatfitaf.com>",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000BB",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      },
      // Invocation logs would carry request metadata; the IP is used for rate limiting and not kept.
      "observability": { "enabled": false }
    }
  }
}
